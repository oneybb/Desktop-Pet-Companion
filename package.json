{
  "name": "desktop-pet-companion",
  "private": true,
  "version": "0.0.0",
  "description": "Floating desktop pet widget app.",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Desktop Pet Companion",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:export": "concurrently -k \"node scripts/export-desktop-app.cjs\" \"npm run dev\"",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "vite build",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win": "npm run build && electron-builder --win portable --x64",
    "desktop:dist:win:setup": "npm run build && electron-builder --win nsis --x64",
    "desktop:dist:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "preview": "vite preview",
    "clean": "rm -rf dist release public/exported-assets public/desktop-pet-seed.json server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.desktoppet.companion",
    "productName": "Desktop Pet Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "DesktopPetCompanion-${version}-mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "executableName": "DesktopPetCompanion",
      "artifactName": "DesktopPetCompanion-${version}-${os}-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DesktopPetCompanion-${version}-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DesktopPetCompanion-${version}-Setup.exe",
      "shortcutName": "Desktop Pet Companion",
      "uninstallDisplayName": "Desktop Pet Companion"
    }
  }
}
